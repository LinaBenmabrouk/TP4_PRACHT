<header class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-4">
  <a href="/" class="text-lg font-semibold text-slate-950 hover:text-slate-600 sm:text-xl">
    TP Observable Plot
  </a>

  <nav class="flex flex-wrap items-center justify-end gap-4" aria-label="Navigation principale">
    <a href="/ancres" class="hover:text-slate-600">Toutes les espèces</a>
    <a href="/tabs/" class="hover:text-slate-600">Tabs</a>
    <a href="/iframe/" class="hover:text-slate-600">Iframe</a>

    <label for="species" class="sr-only">Choisir une espèce</label>
    <select
      id="species"
      class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm outline-none transition hover:border-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
    >
      <option value="">Choisir une espèce</option>
      <option value="Adelie">Adelie</option>
      <option value="Chinstrap">Chinstrap</option>
      <option value="Gentoo">Gentoo</option>
    </select>
  </nav>
</header>

<script>
  const speciesSelect = document.querySelector("#species") as HTMLSelectElement | null;
  const currentSpecies = window.location.pathname.match(/^\/species\/([^/]+)\/?$/)?.[1];

  if (speciesSelect && currentSpecies) {
    speciesSelect.value = currentSpecies;
  }

  speciesSelect?.addEventListener("change", (event) => {
    const select = event.currentTarget as HTMLSelectElement;

    if (select.value) {
      window.location.pathname = `/species/${select.value}/`;
    }
  });
</script>
